{
  "name": "music-assistant-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Music Assistant share link handler - open shared tracks, albums, artists and playlists in your own Music Assistant instance",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,html,css}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^14.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.2.0",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "vue-tsc": "^3.3.9"
  }
}
